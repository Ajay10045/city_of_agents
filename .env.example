# Copy this file to .env and fill in your values

# LLM provider: openai | anthropic | ollama
LLM_PROVIDER=openai

# Provider keys (set one based on LLM_PROVIDER)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional shared key variable used by both providers
# LLM_API_KEY=

# Model used for opposition agent and mayor advisor (default: gpt-4o)
LLM_MODEL=gpt-4o

# Model used for citizen debates and event generation (default: gpt-4o-mini)
LLM_DEBATE_MODEL=gpt-4o-mini

# Optional Anthropic output cap for JSON-heavy prompts (default: 2500)
# LLM_MAX_TOKENS=2500

# --- Ollama (free local dev) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:14b            # low-volume: mayor advisor, opposition agent
# LLM_DEBATE_MODEL=llama3.2:3b     # high-volume: citizen debates, event generation
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Setup-time profile generation ---
# Defaults to Anthropic for high-quality city profile generation.
# Runtime turn simulation still uses LLM_PROVIDER/LLM_MODEL above.
# SETUP_LLM_PROVIDER=anthropic
# SETUP_LLM_MODEL=claude-3-5-sonnet-latest
# SETUP_RESEARCH_MODE=auto          # auto | provider_web | backend_fetch
