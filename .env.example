# Copy this file to .env and fill in your values

# LLM provider: openai | anthropic | deepseek | ollama
LLM_PROVIDER=ollama

# Model for the chosen provider
# openai:    gpt-4o, gpt-4o-mini
# anthropic: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001
# deepseek:  deepseek-chat, deepseek-reasoner
# ollama:    mistral:latest, qwen2.5:14b, llama3.2:3b, …
LLM_MODEL=mistral:latest

# Provider API keys (set the one matching LLM_PROVIDER)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...

# Optional shared key (used as fallback for any provider)
# LLM_API_KEY=

# Ollama server URL (only needed for ollama provider)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Sampling temperature (default: 0.8)
# LLM_TEMPERATURE=0.8

# Max output tokens — applies to Anthropic and DeepSeek (default: 2500)
# LLM_MAX_TOKENS=2500
