# Copy this file to .env and fill in your values

# LLM provider: openai | anthropic
LLM_PROVIDER=openai

# Provider keys (set one based on LLM_PROVIDER)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional shared key variable used by both providers
# LLM_API_KEY=

# Model used for opposition agent and mayor advisor (default: gpt-4o)
LLM_MODEL=gpt-4o

# Model used for citizen debates and event generation (default: gpt-4o-mini)
LLM_DEBATE_MODEL=gpt-4o-mini

# Optional Anthropic output cap for JSON-heavy prompts (default: 2500)
# LLM_MAX_TOKENS=2500
